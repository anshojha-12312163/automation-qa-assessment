{
  "name": "Morning Brief - HackerNews Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://hn.algolia.com/api/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tags",
              "value": "front_page"
            },
            {
              "name": "hitsPerPage",
              "value": "30"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "http1",
      "name": "Fetch Front Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const hits = $input.first().json.hits || [];\nreturn hits\n  .filter(h => h.title)\n  .sort((a, b) => (b.points || 0) - (a.points || 0))\n  .slice(0, 5)\n  .map(h => ({ json: {\n    objectID: h.objectID,\n    title: h.title,\n    url: h.url || `https://news.ycombinator.com/item?id=${h.objectID}`,\n    points: h.points || 0,\n    comments: h.num_comments || 0,\n    author: h.author\n  }}));"
      },
      "id": "keep-top-5",
      "name": "Keep Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "url": "=https://hn.algolia.com/api/v1/items/{{ $json.objectID }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http2",
      "name": "Enrich With Item Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const top = $('Keep Top 5').all().map(i => i.json);\nconst enriched = $input.all().map(i => i.json);\nconst byId = {};\nenriched.forEach(e => { if (e && e.id && !e.error) byId[String(e.id)] = e; });\n\nconst lines = top.map((t, i) => {\n  const e = byId[t.objectID];\n  const extra = e\n    ? `${(e.children || []).length} top-level replies`\n    : 'enrichment unavailable';\n  return `${i + 1}. **${t.title}** - ${t.points} pts, ${t.comments} comments (${extra})\\n<${t.url}>`;\n});\n\nreturn [{ json: {\n  text: lines.join('\\n\\n'),\n  maxPoints: Math.max(...top.map(t => t.points)),\n  failedEnrichments: enriched.filter(e => e && e.error).length\n}}];"
      },
      "id": "build-digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hot-check",
              "leftValue": "={{ $json.maxPoints }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if",
      "name": "Any Story Over 300 Points?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🔥 **Hot morning brief** (top story: {{ $json.maxPoints }} pts)\n\n{{ $json.text }}",
        "options": {}
      },
      "id": "send-hot-digest",
      "name": "Send Hot Digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=📰 **Morning brief**\n\n{{ $json.text }}",
        "options": {}
      },
      "id": "send-normal-digest",
      "name": "Send Normal Digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=⚠️ Morning brief: HackerNews fetch failed after 3 tries. Error: {{ $json.error?.message || 'unknown' }}",
        "options": {}
      },
      "id": "alert-fetch-failed",
      "name": "Alert Fetch Failed",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        440,
        320
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook"
        }
      }
    },
    {
      "parameters": {},
      "id": "errtrig",
      "name": "Workflow Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🚨 Workflow '{{ $json.workflow.name }}' crashed at node '{{ $json.execution.lastNodeExecuted }}': {{ $json.execution.error.message }}",
        "options": {}
      },
      "id": "alert-workflow-error",
      "name": "Alert Workflow Error",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        220,
        480
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook"
        }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Fetch Front Page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Front Page": {
      "main": [
        [
          {
            "node": "Keep Top 5",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert Fetch Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Top 5": {
      "main": [
        [
          {
            "node": "Enrich With Item Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich With Item Details": {
      "main": [
        [
          {
            "node": "Build Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest": {
      "main": [
        [
          {
            "node": "Any Story Over 300 Points?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Story Over 300 Points?": {
      "main": [
        [
          {
            "node": "Send Hot Digest",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Normal Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workflow Error Trigger": {
      "main": [
        [
          {
            "node": "Alert Workflow Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}